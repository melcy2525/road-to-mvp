# Supabase Project Settings > Data API / Connect
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable key only. Never use service_role or sb_secret_* in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Legacy anon public key is also supported instead of PUBLISHABLE_KEY:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
